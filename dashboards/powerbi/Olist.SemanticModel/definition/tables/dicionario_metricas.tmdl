					{ 8, "Taxa nacional de atraso", "A taxa de atraso do país inteiro, usada como régua nas barras por região.", "Taxa de atraso sem o recorte de região e UF do cliente. Aparece como a linha âmbar.", "6,8% de jan/2017 a ago/2018.", "Executivo e Entrega e risco" },
					{ 9, "Atraso em excesso", "Quantos atrasos uma UF teve a mais (ou a menos) do que teria na taxa nacional.", "Atrasos da UF menos os entregues da UF vezes a taxa nacional.", "RJ: +660 atrasos acima do esperado de jan/2017 a ago/2018, com taxa de 12,2%.", "Entrega e risco" },
					{ 10, "Pedidos em alerta", "Pedidos que o modelo de previsão marcou como prováveis atrasos.", "Pedidos com probabilidade de atraso a partir do limiar do modelo (0,11), só nos conjuntos de teste e em andamento.", "8.468 pedidos de jan/2017 a ago/2018.", "Entrega e risco" },
					{ 11, "Receita em risco", "Quanto dinheiro está nos pedidos em alerta.", "Soma da receita (itens + frete) dos pedidos em alerta.", "R$ 1,57 Mi de jan/2017 a ago/2018.", "Entrega e risco" },
					{ 12, "Probabilidade de atraso", "Chance, estimada pelo modelo, de um pedido em andamento chegar depois do prazo.", "Saída do modelo de previsão para cada pedido; a tabela mostra os 50 maiores. Vermelho a partir de 40%, âmbar a partir de 30%.", "52,5% no pedido de maior risco de jan/2017 a ago/2018.", "Entrega e risco" },
					{ 13, "Receita de itens", "Receita no grão de item, que permite separar por vendedor e por categoria.", "Soma de preço mais frete de cada item vendido.", "R$ 15,79 Mi de jan/2017 a ago/2018.", "Vendedores e Executivo" },
