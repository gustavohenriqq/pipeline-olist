{
  "name": "Olist",
  "dataColors": [
    "#0F52BA",
    "#60A5FA",
    "#475569",
    "#93C5FD",
    "#1E3A8A",
    "#94A3B8"
  ],
  "foreground": "#0F172A",
  "foregroundNeutralSecondary": "#475569",
  "background": "#FFFFFF",
  "tableAccent": "#0F52BA",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#475569"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "radius": 12,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "position": "Outer",
            "preset": "Custom",
            "angle": 90,
            "shadowDistance": 2,
            "shadowBlur": 12,
            "shadowSpread": 0,
            "transparency": 90
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 13,
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "bold": true,
            "titleWrap": true
          }
        ],
        "padding": [
          {
            "left": 18,
            "top": 16,
            "right": 18,
            "bottom": 16
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "accentBar": [
          {
            "$id": "default",
            "show": true,
            "position": "Left",
            "color": {
              "solid": {
                "color": "#0F52BA"
              }
            },
            "width": 5
          }
        ],
        "label": [
          {
            "$id": "default",
            "position": "aboveValue",
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#475569"
              }
            }
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#13315C"
              }
            }
          },
          {
            "$id": "hover",
            "fillColor": {
              "solid": {
                "color": "#1E4A80"
              }
            }
          },
          {
            "$id": "selected",
            "fillColor": {
              "solid": {
                "color": "#0F52BA"
              }
            }
          }
        ],
        "text": [
          {
            "$id": "default",
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            }
          },
          {
            "$id": "selected",
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "bold": true
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": false
          }
        ],
        "shape": [
          {
            "$id": "default",
            "tileShape": "rectangleRounded",
            "roundEdge": 8
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "title": [
          {
            "show": true,
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#475569"
              }
            },
            "bold": false
          }
        ]
      }
    },
    "areaChart": {
      "*": {
        "lineStyles": [
          {
            "lineChartType": "smooth",
            "strokeWidth": 3
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopRight"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "rowPadding": 6,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EEF2F7"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#475569"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "bold": true
          }
        ]
      }
    }
  }
}