{
  "name": "Olist",
  "dataColors": [
    "#22D3EE",
    "#8B5CF6",
    "#EC4899",
    "#34D399",
    "#FBBF24",
    "#F87171"
  ],
  "foreground": "#E8ECFF",
  "foregroundNeutralSecondary": "#8E9AC8",
  "background": "#070B1A",
  "tableAccent": "#22D3EE",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#E8ECFF"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#E8ECFF"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#E8ECFF"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#8E9AC8"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#070B1A"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#121A3A"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#232C5C"
              }
            },
            "radius": 12,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#000000"
              }
            },
            "position": "Outer",
            "preset": "Custom",
            "angle": 90,
            "shadowDistance": 2,
            "shadowBlur": 12,
            "shadowSpread": 0,
            "transparency": 60
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 13,
            "fontColor": {
              "solid": {
                "color": "#E8ECFF"
              }
            },
            "bold": true,
            "titleWrap": true
          }
        ],
        "padding": [
          {
            "left": 18,
            "top": 16,
            "right": 18,
            "bottom": 16
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "accentBar": [
          {
            "$id": "default",
            "show": true,
            "position": "Left",
            "color": {
              "solid": {
                "color": "#22D3EE"
              }
            },
            "width": 5
          }
        ],
        "label": [
          {
            "$id": "default",
            "position": "aboveValue",
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#8E9AC8"
              }
            }
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": false
          }
        ]
      }
    },
    "pageNavigator": {
      "*": {
        "fill": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#17214A"
              }
            }
          },
          {
            "$id": "hover",
            "fillColor": {
              "solid": {
                "color": "#232C5C"
              }
            }
          },
          {
            "$id": "selected",
            "fillColor": {
              "solid": {
                "color": "#22D3EE"
              }
            }
          }
        ],
        "text": [
          {
            "$id": "default",
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#8E9AC8"
              }
            }
          },
          {
            "$id": "selected",
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#070B1A"
              }
            },
            "bold": true
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": false
          }
        ],
        "shape": [
          {
            "$id": "default",
            "tileShape": "rectangleRounded",
            "roundEdge": 8
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "title": [
          {
            "show": true,
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#8E9AC8"
              }
            },
            "bold": false
          }
        ]
      }
    },
    "areaChart": {
      "*": {
        "lineStyles": [
          {
            "lineChartType": "smooth",
            "strokeWidth": 3
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopRight"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "rowPadding": 6,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#17214A"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#8E9AC8"
              }
            },
            "backColor": {
              "solid": {
                "color": "#070B1A"
              }
            },
            "bold": true
          }
        ]
      }
    }
  }
}