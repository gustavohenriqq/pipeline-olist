/// Tabela so de medidas (sem dado). As medidas ficam em pastas de exibicao.
table _Medidas
	lineageTag: 025a79eb-9b55-44c4-8e0c-085c5f01f139

	/// Receita do pedido: itens mais frete.
	measure Receita = SUM ( fato_pedidos[valor_total] )
		formatString: \R$ #,0.00
		displayFolder: Vendas
		lineageTag: 33d04f63-0d9f-4c9e-8cb6-f3d351c2779c

	/// Pedidos distintos.
	measure Pedidos = DISTINCTCOUNT ( fato_pedidos[order_id] )
		formatString: #,0
		displayFolder: Vendas
		lineageTag: 323b5885-0c64-4346-a1d7-4ad8ecfcdeae

	/// Receita por pedido.
	measure 'Ticket Médio' = DIVIDE ( [Receita], [Pedidos] )
		formatString: \R$ #,0.00
		displayFolder: Vendas
		lineageTag: 54cab004-c813-4499-ba85-2b17d3d03010

	/// Pessoas distintas (customer_unique_id), nao customer_id.
	measure Clientes = DISTINCTCOUNT ( fato_pedidos[cliente_sk] )
		formatString: #,0
		displayFolder: Vendas
		lineageTag: 8fb3869f-67e5-4611-a477-bff0034d9e53

	/// Receita do mes anterior ao contexto.
	measure 'Receita Mês Anterior' = CALCULATE ( [Receita], DATEADD ( dim_tempo[data], -1, MONTH ) )
		formatString: \R$ #,0.00
		displayFolder: Tempo
		lineageTag: 7f9fa11a-a24f-4efc-80c4-1373171f3929

	/// Em branco quando nao ha mes anterior com venda (DIVIDE nunca gera erro).
	/// Jan/2017 compara com dez/2016, que teve um pedido so: o valor e alto e real.
	measure 'Variação Mensal %' = DIVIDE ( [Receita] - [Receita Mês Anterior], [Receita Mês Anterior] )
		formatString: 0.0%
		displayFolder: Tempo
		lineageTag: b8511e92-ce5f-4c1e-a993-88469661a9db

	/// Receita do inicio do ano ate o contexto.
	measure 'Receita Acumulada no Ano' = TOTALYTD ( [Receita], dim_tempo[data] )
		formatString: \R$ #,0.00
		displayFolder: Tempo
		lineageTag: 66df5b81-2ff0-49eb-b2fe-993bb70b463e

	/// Receita do mesmo periodo no ano anterior.
	measure 'Receita Ano Anterior' = CALCULATE ( [Receita], SAMEPERIODLASTYEAR ( dim_tempo[data] ) )
		formatString: \R$ #,0.00
		displayFolder: Tempo
		lineageTag: f116449b-c773-4b45-bc2b-a817f5855871

	/// Em branco quando nao ha venda no mesmo periodo do ano anterior.
	measure 'Variação Anual %' = DIVIDE ( [Receita] - [Receita Ano Anterior], [Receita Ano Anterior] )
		formatString: 0.0%
		displayFolder: Tempo
		lineageTag: 440a10d7-7491-481b-8415-f9bb15e17105

	/// Pedidos com data de entrega: a base de toda medida de prazo.
	measure Entregues = CALCULATE ( COUNTROWS ( fato_pedidos ), KEEPFILTERS ( NOT ISBLANK ( fato_pedidos[entregue_no_prazo] ) ) )
		formatString: #,0
		displayFolder: Entrega
		lineageTag: 7a1f4773-7bf7-42b8-8be3-7e87cef4d253

	/// Pedidos entregues depois da data estimada. Usa == porque em DAX
	/// BLANK() = FALSE() e verdadeiro: com = os pedidos sem entrega entrariam.
	measure Atrasos = CALCULATE ( COUNTROWS ( fato_pedidos ), KEEPFILTERS ( fato_pedidos[entregue_no_prazo] == FALSE () ) )
		formatString: #,0
		displayFolder: Entrega
		lineageTag: f9209078-7623-49f1-b6a3-8ad83839be22

	/// Atrasos sobre entregues.
	measure 'Taxa de Atraso' = DIVIDE ( [Atrasos], [Entregues] )
		formatString: 0.0%
		displayFolder: Entrega
		lineageTag: 100a777d-0baa-479c-b855-5e8dd6b2b303

	/// Entregues no prazo sobre entregues.
	measure '% no Prazo' = DIVIDE ( [Entregues] - [Atrasos], [Entregues] )
		formatString: 0.0%
		displayFolder: Entrega
		lineageTag: 535ef1bb-72a6-4546-b80b-108309874fda

	/// Taxa sem o recorte geografico do cliente. Nao atravessa o RLS: para um
	/// gerente regional vira a taxa da propria regiao.
	measure 'Taxa Nacional de Atraso' = CALCULATE ( [Taxa de Atraso], REMOVEFILTERS ( dim_clientes ) )
		formatString: 0.0%
		displayFolder: Entrega
		lineageTag: 8f678c12-dd07-42f5-9a2a-1f99e2ef68b8

	/// Atrasos acima do esperado pela taxa nacional (achado da Etapa 2: RJ no topo).
	measure 'Atraso em Excesso' = [Atrasos] - [Entregues] * [Taxa Nacional de Atraso]
		formatString: #,0
		displayFolder: Entrega
		lineageTag: 7c9cdb0d-5b48-485e-aa8c-0418651e2f42

	/// Media da nota de avaliacao (1 a 5).
	measure 'Nota Média' = AVERAGE ( fato_pedidos[nota_avaliacao] )
		formatString: 0.00
		displayFolder: Satisfação
		lineageTag: 432b83f1-2d3c-41db-a4b8-1bc682312635

	/// So teste e em_andamento: previsoes sobre treino e validacao sao otimistas.
	/// KEEPFILTERS intersecta com o filtro do visual em vez de substituir.
	measure 'Pedidos em Alerta' =
			CALCULATE (
			    COUNTROWS ( previsao_atraso ),
			    KEEPFILTERS ( previsao_atraso[alerta] = TRUE () ),
			    KEEPFILTERS ( previsao_atraso[conjunto] IN { "teste", "em_andamento" } )
			)
		formatString: #,0
		displayFolder: Risco
		lineageTag: c724e447-d9f7-4e57-b11e-5006c20fd030

	/// Receita dos pedidos em alerta, mesmo filtro de conjunto.
	measure 'Receita em Risco' =
			SUMX (
			    FILTER (
			        previsao_atraso,
			        previsao_atraso[alerta] = TRUE ()
			            && previsao_atraso[conjunto] IN { "teste", "em_andamento" }
			    ),
			    RELATED ( fato_pedidos[valor_total] )
			)
		formatString: \R$ #,0.00
		displayFolder: Risco
		lineageTag: b634f351-7f4c-4858-90e1-be63eee2ca2a

	/// Medidas no grao de item: exatas para o perfil Vendedor.
	measure 'Receita de Itens' = SUM ( fato_itens_pedido[valor_item] )
		formatString: \R$ #,0.00
		displayFolder: Vendedores
		lineageTag: d8f5787b-c685-46ac-a077-1ec55faaed5f

	/// Itens vendidos (linhas de fato_itens_pedido).
	measure Itens = COUNTROWS ( fato_itens_pedido )
		formatString: #,0
		displayFolder: Vendedores
		lineageTag: cbd7cece-9cd7-4402-8c61-83a0b47bc74c

	/// Taxa de atraso dos pedidos que tem itens no recorte (ex.: um vendedor).
	measure 'Taxa de Atraso dos Itens' =
			CALCULATE (
			    [Taxa de Atraso],
			    TREATAS ( VALUES ( fato_itens_pedido[order_id] ), fato_pedidos[order_id] )
			)
		formatString: 0.0%
		displayFolder: Vendedores
		lineageTag: 526f4fb1-14e4-41bb-b478-6a3523ae6d1c

	/// Ultimo mes com venda dentro do periodo selecionado (ex.: "2018-08"). Base
	/// dos destaques dos cartoes: o mes contra o anterior, nao o periodo inteiro.
	measure 'Mês de Referência' =
			MAXX (
			    FILTER ( VALUES ( dim_tempo[ano_mes] ), NOT ISBLANK ( [Receita] ) ),
			    dim_tempo[ano_mes]
			)
		displayFolder: Destaques
		lineageTag: dba78a3b-b621-4afb-91ca-2ef7b7caab9e

	/// Texto do rodape dos cartoes, ex.: "ago/2018 contra o mês anterior".
	measure 'Rótulo do Destaque' =
			VAR mes = [Mês de Referência]
			RETURN
			    IF (
			        NOT ISBLANK ( mes ),
			        FORMAT ( DATEVALUE ( mes & "-01" ), "mmm/yyyy" ) & " contra o mês anterior"
			    )
		displayFolder: Destaques
		lineageTag: 76050e49-3d99-41dd-91ac-e4580c936b9c

	/// Variacao da receita no mes de referencia contra o mes anterior.
	measure 'Δ Receita' =
			VAR mes = [Mês de Referência]
			VAR atual = CALCULATE ( [Receita], dim_tempo[ano_mes] = mes )
			VAR anterior =
			    CALCULATE (
			        CALCULATE ( [Receita], DATEADD ( dim_tempo[data], -1, MONTH ) ),
			        dim_tempo[ano_mes] = mes
			    )
			RETURN
			    IF ( NOT ISBLANK ( anterior ), DIVIDE ( atual - anterior, anterior ) )
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		displayFolder: Destaques
		lineageTag: 1541b18a-7b62-44b3-9bf7-f3d2245e0930

	/// Variacao dos pedidos no mes de referencia contra o mes anterior.
	measure 'Δ Pedidos' =
			VAR mes = [Mês de Referência]
			VAR atual = CALCULATE ( [Pedidos], dim_tempo[ano_mes] = mes )
			VAR anterior =
			    CALCULATE (
			        CALCULATE ( [Pedidos], DATEADD ( dim_tempo[data], -1, MONTH ) ),
			        dim_tempo[ano_mes] = mes
			    )
			RETURN
			    IF ( NOT ISBLANK ( anterior ), DIVIDE ( atual - anterior, anterior ) )
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		displayFolder: Destaques
		lineageTag: 153c1d73-ef77-4139-9cd8-f9459169f098

	/// Variacao do ticket medio no mes de referencia contra o mes anterior.
	measure 'Δ Ticket Médio' =
			VAR mes = [Mês de Referência]
			VAR atual = CALCULATE ( [Ticket Médio], dim_tempo[ano_mes] = mes )
			VAR anterior =
			    CALCULATE (
			        CALCULATE ( [Ticket Médio], DATEADD ( dim_tempo[data], -1, MONTH ) ),
			        dim_tempo[ano_mes] = mes
			    )
			RETURN
			    IF ( NOT ISBLANK ( anterior ), DIVIDE ( atual - anterior, anterior ) )
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		displayFolder: Destaques
		lineageTag: 4a04f19b-4316-4753-8217-8dcd5884dbec

	/// Diferenca do % no prazo, em pontos percentuais, contra o mes anterior.
	measure 'Δ % no Prazo' =
			VAR mes = [Mês de Referência]
			VAR atual = CALCULATE ( [% no Prazo], dim_tempo[ano_mes] = mes )
			VAR anterior =
			    CALCULATE (
			        CALCULATE ( [% no Prazo], DATEADD ( dim_tempo[data], -1, MONTH ) ),
			        dim_tempo[ano_mes] = mes
			    )
			RETURN
			    IF ( NOT ISBLANK ( anterior ), ( atual - anterior ) * 100 )
		formatString: ▲ 0.0 \p\p;▼ 0.0 \p\p;0.0 \p\p
		displayFolder: Destaques
		lineageTag: e673f7db-7f05-44f3-b52c-2ae94a75ea97

	/// Diferenca da nota media contra o mes anterior.
	measure 'Δ Nota Média' =
			VAR mes = [Mês de Referência]
			VAR atual = CALCULATE ( [Nota Média], dim_tempo[ano_mes] = mes )
			VAR anterior =
			    CALCULATE (
			        CALCULATE ( [Nota Média], DATEADD ( dim_tempo[data], -1, MONTH ) ),
			        dim_tempo[ano_mes] = mes
			    )
			RETURN
			    IF ( NOT ISBLANK ( anterior ), atual - anterior )
		formatString: ▲ 0.00;▼ 0.00;0.00
		displayFolder: Destaques
		lineageTag: 7acdac82-a0ae-4769-b470-049b77b28934

	/// Diferenca da taxa de atraso, em pontos percentuais, contra o mes anterior.
	measure 'Δ Taxa de Atraso' =
			VAR mes = [Mês de Referência]
			VAR atual = CALCULATE ( [Taxa de Atraso], dim_tempo[ano_mes] = mes )
			VAR anterior =
			    CALCULATE (
			        CALCULATE ( [Taxa de Atraso], DATEADD ( dim_tempo[data], -1, MONTH ) ),
			        dim_tempo[ano_mes] = mes
			    )
			RETURN
			    IF ( NOT ISBLANK ( anterior ), ( atual - anterior ) * 100 )
		formatString: ▲ 0.0 \p\p;▼ 0.0 \p\p;0.0 \p\p
		displayFolder: Destaques
		lineageTag: 738f080f-b05a-468a-91ab-ec4cdfd9bea3

	/// Variacao da receita de itens no mes de referencia contra o mes anterior.
	measure 'Δ Receita de Itens' =
			VAR mes = [Mês de Referência]
			VAR atual = CALCULATE ( [Receita de Itens], dim_tempo[ano_mes] = mes )
			VAR anterior =
			    CALCULATE (
			        CALCULATE ( [Receita de Itens], DATEADD ( dim_tempo[data], -1, MONTH ) ),
			        dim_tempo[ano_mes] = mes
			    )
			RETURN
			    IF ( NOT ISBLANK ( anterior ), DIVIDE ( atual - anterior, anterior ) )
		formatString: ▲ 0.0%;▼ 0.0%;0.0%
		displayFolder: Destaques
		lineageTag: 2cf62822-a2e6-4c53-b645-fd15ccf7ca3f

	/// Medidas de cor (hex) para a formatacao condicional por valor de campo.
	/// Verde quando a mudanca e boa, vermelho quando e ruim.
	measure 'Cor Δ Receita' = IF ( [Δ Receita] >= 0, "#15803D", "#B91C1C" )
		isHidden
		displayFolder: Cores
		lineageTag: 657b4e0a-809e-4235-a08e-888703d0cc5f

	measure 'Cor Δ Pedidos' = IF ( [Δ Pedidos] >= 0, "#15803D", "#B91C1C" )
		isHidden
		displayFolder: Cores
		lineageTag: 99db71ad-35ec-4091-a59f-6244d8665336

	measure 'Cor Δ Ticket Médio' = IF ( [Δ Ticket Médio] >= 0, "#15803D", "#B91C1C" )
		isHidden
		displayFolder: Cores
		lineageTag: 0c5d8e36-08ae-431e-801b-d6ab6abfb0c2

	measure 'Cor Δ % no Prazo' = IF ( [Δ % no Prazo] >= 0, "#15803D", "#B91C1C" )
		isHidden
		displayFolder: Cores
		lineageTag: 6e8fefdd-7e6a-4d9e-91b2-d5eefed9b860

	measure 'Cor Δ Nota Média' = IF ( [Δ Nota Média] >= 0, "#15803D", "#B91C1C" )
		isHidden
		displayFolder: Cores
		lineageTag: 86c6d831-5222-436b-a250-0055cca5af83

	measure 'Cor Δ Receita de Itens' = IF ( [Δ Receita de Itens] >= 0, "#15803D", "#B91C1C" )
		isHidden
		displayFolder: Cores
		lineageTag: b7f431fc-06c5-4f01-acc5-c85f089838a5

	measure 'Cor Δ Taxa de Atraso' = IF ( [Δ Taxa de Atraso] >= 0, "#B91C1C", "#15803D" )
		isHidden
		displayFolder: Cores
		lineageTag: 5c816cd0-e702-4200-8b20-b445a666099e

	measure 'Cor Variação Mensal' = IF ( [Variação Mensal %] >= 0, "#15803D", "#B91C1C" )
		isHidden
		displayFolder: Cores
		lineageTag: 88b1b6f1-0001-4296-b0b9-b3e21a83fc22

	/// Atraso acima do esperado em vermelho; abaixo, no azul do tema.
	measure 'Cor Atraso em Excesso' = IF ( [Atraso em Excesso] > 0, "#B91C1C", "#0F52BA" )
		isHidden
		displayFolder: Cores
		lineageTag: 370d360e-b2fc-4afa-a464-bcfbe64a6886

	/// Fundo da probabilidade de atraso: vermelho claro a partir de 40%, ambar a partir de 30%.
	measure 'Cor Prob. de Atraso' =
			VAR p = MAX ( previsao_atraso[prob_atraso] )
			RETURN
			    SWITCH ( TRUE (), p >= 0.4, "#FEE2E2", p >= 0.3, "#FEF3C7" )
		isHidden
		displayFolder: Cores
		lineageTag: 9ec5f75b-1bea-4808-b7fd-0cdebaa41b31

	/// Menu lateral (molde): {A1..3} e {S1..3} marcam o icone da pagina ativa.
	measure 'HTML Menu Base' = "<div style='font-family:Segoe UI,sans-serif;height:100vh;box-sizing:border-box;background:linear-gradient(180deg,#141C44,#0D1330);border:1.4px solid rgba(130,150,255,0.14);border-radius:30.8px;display:flex;flex-direction:column;align-items:center;padding:25.2px 0;gap:19.6px'><div style='width:58.8px;height:58.8px;border-radius:19.6px;background:linear-gradient(135deg,#22D3EE,#8B5CF6);display:flex;align-items:center;justify-content:center;margin-bottom:14px'><svg width='22' height='22' viewBox='0 0 24 24' fill='none' stroke='#06102A' stroke-width='2.6' stroke-linecap='round'><path d='M5 19V11M12 19V5M19 19v-6'/></svg></div><div {A1} style='width:64.4px;height:64.4px;border-radius:19.6px;display:flex;align-items:center;justify-content:center;{S1}'><svg width='22' height='22' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round'><path d='M3 12l9-8 9 8M5 10v10h14V10'/></svg></div><div {A2} style='width:64.4px;height:64.4px;border-radius:19.6px;display:flex;align-items:center;justify-content:center;{S2}'><svg width='22' height='22' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round'><path d='M3 7h11v9H3zM14 10h4l3 3v3h-7M7 19a2 2 0 100-4 2 2 0 000 4zM17 19a2 2 0 100-4 2 2 0 000 4z'/></svg></div><div {A3} style='width:64.4px;height:64.4px;border-radius:19.6px;display:flex;align-items:center;justify-content:center;{S3}'><svg width='22' height='22' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round'><path d='M4 9l2-5h12l2 5M4 9v11h16V9M4 9h16M9 20v-6h6v6'/></svg></div><div style='flex:1'></div><div  style='width:64.4px;height:64.4px;border-radius:19.6px;display:flex;align-items:center;justify-content:center;color:#8E9AC8'><svg width='22' height='22' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round'><path d='M5 4h11a3 3 0 013 3v13H8a3 3 0 01-3-3zM5 17a3 3 0 013-3h11'/></svg></div></div>"
		isHidden
		displayFolder: HTML
		lineageTag: c454d9ee-ead7-413d-b41d-135cbf5fa20a

	/// Menu lateral com a pagina Executivo ativa.
	measure 'HTML Menu Executivo' = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [HTML Menu Base], "{A1}", "data-ativo='1'" ), "{S1}", "background:rgba(34,211,238,0.14);color:#22D3EE;box-shadow:inset 4.2px 0 0 #22D3EE" ), "{A2}", "" ), "{S2}", "color:#8E9AC8" ), "{A3}", "" ), "{S3}", "color:#8E9AC8" )
		displayFolder: HTML
		lineageTag: b41a52fd-6309-4b4a-95a7-0cf752885938

	/// Menu lateral com a pagina Entrega ativa.
	measure 'HTML Menu Entrega' = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [HTML Menu Base], "{A1}", "" ), "{S1}", "color:#8E9AC8" ), "{A2}", "data-ativo='1'" ), "{S2}", "background:rgba(34,211,238,0.14);color:#22D3EE;box-shadow:inset 4.2px 0 0 #22D3EE" ), "{A3}", "" ), "{S3}", "color:#8E9AC8" )
		displayFolder: HTML
		lineageTag: c6e3fa8e-e1a1-4624-a962-ea44148a6d1c

	/// Menu lateral com a pagina Vendedores ativa.
	measure 'HTML Menu Vendedores' = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [HTML Menu Base], "{A1}", "" ), "{S1}", "color:#8E9AC8" ), "{A2}", "" ), "{S2}", "color:#8E9AC8" ), "{A3}", "data-ativo='1'" ), "{S3}", "background:rgba(34,211,238,0.14);color:#22D3EE;box-shadow:inset 4.2px 0 0 #22D3EE" )
		displayFolder: HTML
		lineageTag: adca144c-3a97-466d-a2d7-bf61876ba39c

	/// Cabecalho (molde): {T} titulo, {S} subtitulo.
	measure 'HTML Cabeçalho Base' = "<div style='font-family:Segoe UI,sans-serif;display:flex;flex-direction:column;justify-content:center;height:100vh'><div style='font-size:36.4px;font-weight:700;color:#E8ECFF;letter-spacing:-0.01em'>{T}</div><div style='font-size:17.5px;color:#8E9AC8;margin-top:2.8px'>{S} · " & [Rótulo do Destaque] & "</div></div>"
		isHidden
		displayFolder: HTML
		lineageTag: ae548730-ad9f-4df5-a301-c9d1865161d1

	/// Cabecalho da pagina Executivo.
	measure 'HTML Cabeçalho Executivo' = SUBSTITUTE ( SUBSTITUTE ( [HTML Cabeçalho Base], "{T}", "Visão <span style='background:linear-gradient(90deg,#22D3EE,#8B5CF6);-webkit-background-clip:text;background-clip:text;color:transparent'>executiva</span>" ), "{S}", "Receita, volume, prazo e satisfação" )
		displayFolder: HTML
		lineageTag: a57f264b-c1ba-4115-9f9c-dd872bc6fcf2

	/// Cabecalho da pagina Entrega.
	measure 'HTML Cabeçalho Entrega' = SUBSTITUTE ( SUBSTITUTE ( [HTML Cabeçalho Base], "{T}", "Entrega <span style='background:linear-gradient(90deg,#22D3EE,#8B5CF6);-webkit-background-clip:text;background-clip:text;color:transparent'>e risco</span>" ), "{S}", "Atraso por região e UF e pedidos em andamento com maior risco previsto" )
		displayFolder: HTML
		lineageTag: 2b53328f-e32e-4c02-891f-1912cf2fe6dd

	/// Cabecalho da pagina Vendedores.
	measure 'HTML Cabeçalho Vendedores' = SUBSTITUTE ( SUBSTITUTE ( [HTML Cabeçalho Base], "{T}", "<span style='background:linear-gradient(90deg,#22D3EE,#8B5CF6);-webkit-background-clip:text;background-clip:text;color:transparent'>Vendedores</span>" ), "{S}", "No grão de item: exato para cada vendedor" )
		displayFolder: HTML
		lineageTag: 8e169fd6-3a64-4393-85d8-84ab6043622e

	/// Cartoes da visao executiva: receita, pedidos e ticket com mini-grafico; aneis de % no prazo e nota.
	measure 'HTML Cartões Executivo' =
			VAR t_rec = FILTER ( ADDCOLUMNS ( VALUES ( dim_tempo[ano_mes] ), "@v", [Receita] ), NOT ISBLANK ( [@v] ) )
			VAR n_rec = COUNTROWS ( t_rec )
			VAR mx_rec = MAXX ( t_rec, [@v] )
			VAR mn_rec = MINX ( t_rec, [@v] )
			VAR pts_rec = CONCATENATEX ( t_rec, FORMAT ( ( RANKX ( t_rec, dim_tempo[ano_mes], , ASC ) - 1 ) * 300 / MAX ( n_rec - 1, 1 ), "0.0", "en-US" ) & "," & FORMAT ( 42 - DIVIDE ( [@v] - mn_rec, mx_rec - mn_rec, 0.5 ) * 34, "0.0", "en-US" ), " L ", dim_tempo[ano_mes], ASC )
			VAR spark_rec = IF ( n_rec > 1, "<svg viewBox='0 0 300 46' preserveAspectRatio='none' style='position:absolute;left:0;bottom:0;width:100%;height:64.4px'><defs><linearGradient id='grec' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#22D3EE' stop-opacity='0.45'/><stop offset='1' stop-color='#22D3EE' stop-opacity='0'/></linearGradient></defs><path d='M0,46 L " & pts_rec & " L300,46 Z' fill='url(#grec)'/><path d='M" & pts_rec & "' fill='none' stroke='#22D3EE' stroke-width='2'/></svg>" )
			VAR t_ped = FILTER ( ADDCOLUMNS ( VALUES ( dim_tempo[ano_mes] ), "@v", [Pedidos] ), NOT ISBLANK ( [@v] ) )
			VAR n_ped = COUNTROWS ( t_ped )
			VAR mx_ped = MAXX ( t_ped, [@v] )
			VAR mn_ped = MINX ( t_ped, [@v] )
			VAR pts_ped = CONCATENATEX ( t_ped, FORMAT ( ( RANKX ( t_ped, dim_tempo[ano_mes], , ASC ) - 1 ) * 300 / MAX ( n_ped - 1, 1 ), "0.0", "en-US" ) & "," & FORMAT ( 42 - DIVIDE ( [@v] - mn_ped, mx_ped - mn_ped, 0.5 ) * 34, "0.0", "en-US" ), " L ", dim_tempo[ano_mes], ASC )
			VAR spark_ped = IF ( n_ped > 1, "<svg viewBox='0 0 300 46' preserveAspectRatio='none' style='position:absolute;left:0;bottom:0;width:100%;height:64.4px'><defs><linearGradient id='gped' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#8B5CF6' stop-opacity='0.45'/><stop offset='1' stop-color='#8B5CF6' stop-opacity='0'/></linearGradient></defs><path d='M0,46 L " & pts_ped & " L300,46 Z' fill='url(#gped)'/><path d='M" & pts_ped & "' fill='none' stroke='#8B5CF6' stroke-width='2'/></svg>" )
			VAR t_tic = FILTER ( ADDCOLUMNS ( VALUES ( dim_tempo[ano_mes] ), "@v", [Ticket Médio] ), NOT ISBLANK ( [@v] ) )
			VAR n_tic = COUNTROWS ( t_tic )
			VAR mx_tic = MAXX ( t_tic, [@v] )
			VAR mn_tic = MINX ( t_tic, [@v] )
			VAR pts_tic = CONCATENATEX ( t_tic, FORMAT ( ( RANKX ( t_tic, dim_tempo[ano_mes], , ASC ) - 1 ) * 300 / MAX ( n_tic - 1, 1 ), "0.0", "en-US" ) & "," & FORMAT ( 42 - DIVIDE ( [@v] - mn_tic, mx_tic - mn_tic, 0.5 ) * 34, "0.0", "en-US" ), " L ", dim_tempo[ano_mes], ASC )
			VAR spark_tic = IF ( n_tic > 1, "<svg viewBox='0 0 300 46' preserveAspectRatio='none' style='position:absolute;left:0;bottom:0;width:100%;height:64.4px'><defs><linearGradient id='gtic' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#EC4899' stop-opacity='0.45'/><stop offset='1' stop-color='#EC4899' stop-opacity='0'/></linearGradient></defs><path d='M0,46 L " & pts_tic & " L300,46 Z' fill='url(#gtic)'/><path d='M" & pts_tic & "' fill='none' stroke='#EC4899' stroke-width='2'/></svg>" )
			VAR d_rec = [Δ Receita]
			VAR dt_rec = IF ( ISBLANK ( d_rec ), "sem mês anterior", "<b style='color:" & IF ( d_rec >= 0, "#34D399", "#F87171" ) & "'>" & IF ( d_rec >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d_rec ), "0.0%" ) & "</b> vs. mês anterior" )
			VAR d_ped = [Δ Pedidos]
			VAR dt_ped = IF ( ISBLANK ( d_ped ), "sem mês anterior", "<b style='color:" & IF ( d_ped >= 0, "#34D399", "#F87171" ) & "'>" & IF ( d_ped >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d_ped ), "0.0%" ) & "</b> vs. mês anterior" )
			VAR d_tic = [Δ Ticket Médio]
			VAR dt_tic = IF ( ISBLANK ( d_tic ), "sem mês anterior", "<b style='color:" & IF ( d_tic >= 0, "#34D399", "#F87171" ) & "'>" & IF ( d_tic >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d_tic ), "0.0%" ) & "</b> vs. mês anterior" )
			VAR d_pra = [Δ % no Prazo]
			VAR dt_pra = IF ( ISBLANK ( d_pra ), "sem mês anterior", "<b style='color:" & IF ( d_pra >= 0, "#34D399", "#F87171" ) & "'>" & IF ( d_pra >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d_pra ), "0.0" ) & " pp</b> vs. mês anterior" )
			VAR d_not = [Δ Nota Média]
			VAR dt_not = IF ( ISBLANK ( d_not ), "sem mês anterior", "<b style='color:" & IF ( d_not >= 0, "#34D399", "#F87171" ) & "'>" & IF ( d_not >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d_not ), "0.00" ) & "</b> vs. mês anterior" )
			VAR v_rec = IF ( ISBLANK ( [Receita] ), "sem dados", IF ( [Receita] >= 1000000, "R$ " & FORMAT ( [Receita] / 1000000, "#,0.00" ) & " Mi", "R$ " & FORMAT ( [Receita], "#,0.00" ) ) )
			VAR v_ped = IF ( ISBLANK ( [Pedidos] ), "sem dados", FORMAT ( [Pedidos], "#,0" ) )
			VAR v_tic = IF ( ISBLANK ( [Ticket Médio] ), "sem dados", "R$ " & FORMAT ( [Ticket Médio], "#,0.00" ) )
			VAR v_pra = IF ( ISBLANK ( [% no Prazo] ), "sem dados", FORMAT ( [% no Prazo], "0.0%" ) )
			VAR v_not = IF ( ISBLANK ( [Nota Média] ), "sem dados", FORMAT ( [Nota Média], "0.00" ) )
			VAR tem = NOT ISBLANK ( [Receita] )
			VAR aneis = "<div style='flex:1.15;box-sizing:border-box;background:linear-gradient(160deg,#17214A,#121A3A);border:1.4px solid rgba(130,150,255,0.14);border-radius:25.2px;display:flex;align-items:center;justify-content:space-around;height:calc(100vh - 8.4px)'>" & "<div style='display:flex;flex-direction:column;align-items:center;gap:4.2px;font-size:16.1px;color:#8E9AC8'>" & "<svg width='109' height='109' viewBox='0 0 78 78'><defs><linearGradient id='apra'><stop offset='0' stop-color='#22D3EE'/><stop offset='1' stop-color='#34D399'/></linearGradient></defs><circle cx='39' cy='39' r='31' fill='none' stroke='rgba(130,150,255,0.14)' stroke-width='8'/><circle cx='39' cy='39' r='31' fill='none' stroke='url(#apra)' stroke-width='8' stroke-linecap='round' stroke-dasharray='" & FORMAT ( 194.8 * COALESCE ( [% no Prazo], 0 ), "0.0", "en-US" ) & " 195' transform='rotate(-90 39 39)'/><text x='39' y='44' text-anchor='middle' fill='#E8ECFF' font-size='15' font-weight='700'>" & v_pra & "</text></svg>" & "% no prazo<span>" & IF ( tem, dt_pra ) & "</span></div>" & "<div style='display:flex;flex-direction:column;align-items:center;gap:4.2px;font-size:16.1px;color:#8E9AC8'>" & "<svg width='109' height='109' viewBox='0 0 78 78'><defs><linearGradient id='anot'><stop offset='0' stop-color='#8B5CF6'/><stop offset='1' stop-color='#EC4899'/></linearGradient></defs><circle cx='39' cy='39' r='31' fill='none' stroke='rgba(130,150,255,0.14)' stroke-width='8'/><circle cx='39' cy='39' r='31' fill='none' stroke='url(#anot)' stroke-width='8' stroke-linecap='round' stroke-dasharray='" & FORMAT ( 194.8 * COALESCE ( [Nota Média], 0 ) / 5, "0.0", "en-US" ) & " 195' transform='rotate(-90 39 39)'/><text x='39' y='44' text-anchor='middle' fill='#E8ECFF' font-size='15' font-weight='700'>" & v_not & "</text></svg>" & "Nota média<span>" & IF ( tem, dt_not ) & "</span></div></div>"
			RETURN
			"<div style='display:flex;gap:19.6px;font-family:Segoe UI,sans-serif;height:100vh;box-sizing:border-box;padding:2.8px'>" & "<div style='position:relative;overflow:hidden;flex:1;box-sizing:border-box;background:linear-gradient(160deg,#17214A,#121A3A);border:1.4px solid rgba(130,150,255,0.14);border-radius:25.2px;padding:19.6px 22.4px;height:calc(100vh - 8.4px)'><div style='font-size:16.8px;color:#8E9AC8;display:flex;align-items:center;gap:11.2px'><span style='width:36.4px;height:36.4px;border-radius:12.6px;display:inline-flex;align-items:center;justify-content:center;background:rgba(34,211,238,0.16);color:#22D3EE;font-weight:700'>R$</span>Receita</div><div style='font-size:35px;font-weight:700;margin:8.4px 0 2.8px;color:#E8ECFF'>" & v_rec & "</div>" & "<div style='font-size:16.1px;color:#8E9AC8'>" & IF ( tem, dt_rec ) & "</div>" & spark_rec & "</div>" & "<div style='position:relative;overflow:hidden;flex:1;box-sizing:border-box;background:linear-gradient(160deg,#17214A,#121A3A);border:1.4px solid rgba(130,150,255,0.14);border-radius:25.2px;padding:19.6px 22.4px;height:calc(100vh - 8.4px)'><div style='font-size:16.8px;color:#8E9AC8;display:flex;align-items:center;gap:11.2px'><span style='width:36.4px;height:36.4px;border-radius:12.6px;display:inline-flex;align-items:center;justify-content:center;background:rgba(139,92,246,0.18);color:#8B5CF6;font-weight:700'>#</span>Pedidos</div><div style='font-size:35px;font-weight:700;margin:8.4px 0 2.8px;color:#E8ECFF'>" & v_ped & "</div>" & "<div style='font-size:16.1px;color:#8E9AC8'>" & IF ( tem, dt_ped ) & "</div>" & spark_ped & "</div>" & "<div style='position:relative;overflow:hidden;flex:1;box-sizing:border-box;background:linear-gradient(160deg,#17214A,#121A3A);border:1.4px solid rgba(130,150,255,0.14);border-radius:25.2px;padding:19.6px 22.4px;height:calc(100vh - 8.4px)'><div style='font-size:16.8px;color:#8E9AC8;display:flex;align-items:center;gap:11.2px'><span style='width:36.4px;height:36.4px;border-radius:12.6px;display:inline-flex;align-items:center;justify-content:center;background:rgba(236,72,153,0.16);color:#EC4899;font-weight:700'>≈</span>Ticket médio</div><div style='font-size:35px;font-weight:700;margin:8.4px 0 2.8px;color:#E8ECFF'>" & v_tic & "</div>" & "<div style='font-size:16.1px;color:#8E9AC8'>" & IF ( tem, dt_tic ) & "</div>" & spark_tic & "</div>" & aneis & "</div>"
		displayFolder: HTML
		lineageTag: 3ddfae3e-f806-42bd-abb9-e30fdcaab1e1

	/// Cartoes de entrega e risco: taxa de atraso (subir e piorar), alertas e receita em risco.
	measure 'HTML Cartões Entrega' =
			VAR t_atr = FILTER ( ADDCOLUMNS ( VALUES ( dim_tempo[ano_mes] ), "@v", [Taxa de Atraso] ), NOT ISBLANK ( [@v] ) )
			VAR n_atr = COUNTROWS ( t_atr )
			VAR mx_atr = MAXX ( t_atr, [@v] )
			VAR mn_atr = MINX ( t_atr, [@v] )
			VAR pts_atr = CONCATENATEX ( t_atr, FORMAT ( ( RANKX ( t_atr, dim_tempo[ano_mes], , ASC ) - 1 ) * 300 / MAX ( n_atr - 1, 1 ), "0.0", "en-US" ) & "," & FORMAT ( 42 - DIVIDE ( [@v] - mn_atr, mx_atr - mn_atr, 0.5 ) * 34, "0.0", "en-US" ), " L ", dim_tempo[ano_mes], ASC )
			VAR spark_atr = IF ( n_atr > 1, "<svg viewBox='0 0 300 46' preserveAspectRatio='none' style='position:absolute;left:0;bottom:0;width:100%;height:64.4px'><defs><linearGradient id='gatr' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#EC4899' stop-opacity='0.45'/><stop offset='1' stop-color='#EC4899' stop-opacity='0'/></linearGradient></defs><path d='M0,46 L " & pts_atr & " L300,46 Z' fill='url(#gatr)'/><path d='M" & pts_atr & "' fill='none' stroke='#EC4899' stroke-width='2'/></svg>" )
			VAR d_atr = [Δ Taxa de Atraso]
			VAR dt_atr = IF ( ISBLANK ( d_atr ), "sem mês anterior", "<b style='color:" & IF ( d_atr >= 0, "#F87171", "#34D399" ) & "'>" & IF ( d_atr >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d_atr ), "0.0" ) & " pp</b> vs. mês anterior" )
			VAR tem = NOT ISBLANK ( [Taxa de Atraso] )
			VAR v_atr = IF ( ISBLANK ( [Taxa de Atraso] ), "sem dados", FORMAT ( [Taxa de Atraso], "0.0%" ) )
			VAR v_ale = IF ( ISBLANK ( [Pedidos em Alerta] ), "sem dados", FORMAT ( [Pedidos em Alerta], "#,0" ) )
			VAR v_ris = IF ( ISBLANK ( [Receita em Risco] ), "sem dados", IF ( [Receita em Risco] >= 1000000, "R$ " & FORMAT ( [Receita em Risco] / 1000000, "#,0.00" ) & " Mi", "R$ " & FORMAT ( [Receita em Risco], "#,0.00" ) ) )
			RETURN
			"<div style='display:flex;gap:19.6px;font-family:Segoe UI,sans-serif;height:100vh;box-sizing:border-box;padding:2.8px'>" & "<div style='position:relative;overflow:hidden;flex:1;box-sizing:border-box;background:linear-gradient(160deg,#17214A,#121A3A);border:1.4px solid rgba(130,150,255,0.14);border-radius:25.2px;padding:19.6px 22.4px;height:calc(100vh - 8.4px)'><div style='font-size:16.8px;color:#8E9AC8;display:flex;align-items:center;gap:11.2px'><span style='width:36.4px;height:36.4px;border-radius:12.6px;display:inline-flex;align-items:center;justify-content:center;background:rgba(236,72,153,0.16);color:#EC4899;font-weight:700'>!</span>Taxa de atraso</div><div style='font-size:35px;font-weight:700;margin:8.4px 0 2.8px;color:#E8ECFF'>" & v_atr & "</div>" & "<div style='font-size:16.1px;color:#8E9AC8'>" & IF ( tem, dt_atr ) & "</div>" & spark_atr & "</div>" & "<div style='position:relative;overflow:hidden;flex:1;box-sizing:border-box;background:linear-gradient(160deg,#17214A,#121A3A);border:1.4px solid rgba(130,150,255,0.14);border-radius:25.2px;padding:19.6px 22.4px;height:calc(100vh - 8.4px)'><div style='font-size:16.8px;color:#8E9AC8;display:flex;align-items:center;gap:11.2px'><span style='width:36.4px;height:36.4px;border-radius:12.6px;display:inline-flex;align-items:center;justify-content:center;background:rgba(139,92,246,0.18);color:#8B5CF6;font-weight:700'>◔</span>Pedidos em alerta</div><div style='font-size:35px;font-weight:700;margin:8.4px 0 2.8px;color:#E8ECFF'>" & v_ale & "</div>" & "</div>" & "<div style='position:relative;overflow:hidden;flex:1;box-sizing:border-box;background:linear-gradient(160deg,#17214A,#121A3A);border:1.4px solid rgba(130,150,255,0.14);border-radius:25.2px;padding:19.6px 22.4px;height:calc(100vh - 8.4px)'><div style='font-size:16.8px;color:#8E9AC8;display:flex;align-items:center;gap:11.2px'><span style='width:36.4px;height:36.4px;border-radius:12.6px;display:inline-flex;align-items:center;justify-content:center;background:rgba(34,211,238,0.16);color:#22D3EE;font-weight:700'>R$</span>Receita em risco</div><div style='font-size:35px;font-weight:700;margin:8.4px 0 2.8px;color:#E8ECFF'>" & v_ris & "</div>" & "</div>" & "</div>"
		displayFolder: HTML
		lineageTag: 5365b252-2e96-49a4-8a36-1202c7a4b646

	/// Cartoes da pagina de vendedores.
	measure 'HTML Cartões Vendedores' =
			VAR t_rit = FILTER ( ADDCOLUMNS ( VALUES ( dim_tempo[ano_mes] ), "@v", [Receita de Itens] ), NOT ISBLANK ( [@v] ) )
			VAR n_rit = COUNTROWS ( t_rit )
			VAR mx_rit = MAXX ( t_rit, [@v] )
			VAR mn_rit = MINX ( t_rit, [@v] )
			VAR pts_rit = CONCATENATEX ( t_rit, FORMAT ( ( RANKX ( t_rit, dim_tempo[ano_mes], , ASC ) - 1 ) * 300 / MAX ( n_rit - 1, 1 ), "0.0", "en-US" ) & "," & FORMAT ( 42 - DIVIDE ( [@v] - mn_rit, mx_rit - mn_rit, 0.5 ) * 34, "0.0", "en-US" ), " L ", dim_tempo[ano_mes], ASC )
			VAR spark_rit = IF ( n_rit > 1, "<svg viewBox='0 0 300 46' preserveAspectRatio='none' style='position:absolute;left:0;bottom:0;width:100%;height:64.4px'><defs><linearGradient id='grit' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#22D3EE' stop-opacity='0.45'/><stop offset='1' stop-color='#22D3EE' stop-opacity='0'/></linearGradient></defs><path d='M0,46 L " & pts_rit & " L300,46 Z' fill='url(#grit)'/><path d='M" & pts_rit & "' fill='none' stroke='#22D3EE' stroke-width='2'/></svg>" )
			VAR d_rit = [Δ Receita de Itens]
			VAR dt_rit = IF ( ISBLANK ( d_rit ), "sem mês anterior", "<b style='color:" & IF ( d_rit >= 0, "#34D399", "#F87171" ) & "'>" & IF ( d_rit >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( d_rit ), "0.0%" ) & "</b> vs. mês anterior" )
			VAR tem = NOT ISBLANK ( [Receita de Itens] )
			VAR v_rit = IF ( ISBLANK ( [Receita de Itens] ), "sem dados", IF ( [Receita de Itens] >= 1000000, "R$ " & FORMAT ( [Receita de Itens] / 1000000, "#,0.00" ) & " Mi", "R$ " & FORMAT ( [Receita de Itens], "#,0.00" ) ) )
			VAR v_ite = IF ( ISBLANK ( [Itens] ), "sem dados", FORMAT ( [Itens], "#,0" ) )
			VAR v_tai = IF ( ISBLANK ( [Taxa de Atraso dos Itens] ), "sem dados", FORMAT ( [Taxa de Atraso dos Itens], "0.0%" ) )
			RETURN
			"<div style='display:flex;gap:19.6px;font-family:Segoe UI,sans-serif;height:100vh;box-sizing:border-box;padding:2.8px'>" & "<div style='position:relative;overflow:hidden;flex:1;box-sizing:border-box;background:linear-gradient(160deg,#17214A,#121A3A);border:1.4px solid rgba(130,150,255,0.14);border-radius:25.2px;padding:19.6px 22.4px;height:calc(100vh - 8.4px)'><div style='font-size:16.8px;color:#8E9AC8;display:flex;align-items:center;gap:11.2px'><span style='width:36.4px;height:36.4px;border-radius:12.6px;display:inline-flex;align-items:center;justify-content:center;background:rgba(34,211,238,0.16);color:#22D3EE;font-weight:700'>R$</span>Receita de itens</div><div style='font-size:35px;font-weight:700;margin:8.4px 0 2.8px;color:#E8ECFF'>" & v_rit & "</div>" & "<div style='font-size:16.1px;color:#8E9AC8'>" & IF ( tem, dt_rit ) & "</div>" & spark_rit & "</div>" & "<div style='position:relative;overflow:hidden;flex:1;box-sizing:border-box;background:linear-gradient(160deg,#17214A,#121A3A);border:1.4px solid rgba(130,150,255,0.14);border-radius:25.2px;padding:19.6px 22.4px;height:calc(100vh - 8.4px)'><div style='font-size:16.8px;color:#8E9AC8;display:flex;align-items:center;gap:11.2px'><span style='width:36.4px;height:36.4px;border-radius:12.6px;display:inline-flex;align-items:center;justify-content:center;background:rgba(139,92,246,0.18);color:#8B5CF6;font-weight:700'>#</span>Itens</div><div style='font-size:35px;font-weight:700;margin:8.4px 0 2.8px;color:#E8ECFF'>" & v_ite & "</div>" & "</div>" & "<div style='position:relative;overflow:hidden;flex:1;box-sizing:border-box;background:linear-gradient(160deg,#17214A,#121A3A);border:1.4px solid rgba(130,150,255,0.14);border-radius:25.2px;padding:19.6px 22.4px;height:calc(100vh - 8.4px)'><div style='font-size:16.8px;color:#8E9AC8;display:flex;align-items:center;gap:11.2px'><span style='width:36.4px;height:36.4px;border-radius:12.6px;display:inline-flex;align-items:center;justify-content:center;background:rgba(236,72,153,0.16);color:#EC4899;font-weight:700'>!</span>Taxa de atraso dos itens</div><div style='font-size:35px;font-weight:700;margin:8.4px 0 2.8px;color:#E8ECFF'>" & v_tai & "</div>" & "</div>" & "</div>"
		displayFolder: HTML
		lineageTag: b1b97ef1-fdd2-406b-ac13-26df6163d785

	/// Receita por mes em area com degrade, ano anterior tracejado e o maior mes em destaque (SVG).
	measure 'HTML Receita Mensal' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( dim_tempo[ano_mes] ), "@v", [Receita], "@a", [Receita Ano Anterior] ), NOT ISBLANK ( [@v] ) )
			VAR n = COUNTROWS ( t )
			VAR mx = MAXX ( t, [@v] )
			VAR topo = MAX ( mx, MAXX ( t, [@a] ) ) * 1.08
			VAR pts = CONCATENATEX ( t, FORMAT ( 48 + ( RANKX ( t, dim_tempo[ano_mes], , ASC ) - 1 ) * 690 / MAX ( n - 1, 1 ), "0.0", "en-US" ) & "," & FORMAT ( 300 - [@v] / topo * 280, "0.0", "en-US" ), " L ", dim_tempo[ano_mes], ASC )
			VAR ta = FILTER ( t, NOT ISBLANK ( [@a] ) )
			VAR ptsa = CONCATENATEX ( ta, FORMAT ( 48 + ( RANKX ( t, dim_tempo[ano_mes], , ASC ) - 1 ) * 690 / MAX ( n - 1, 1 ), "0.0", "en-US" ) & "," & FORMAT ( 300 - [@a] / topo * 280, "0.0", "en-US" ), " L ", dim_tempo[ano_mes], ASC )
			VAR pontos = CONCATENATEX ( t, "<circle cx='" & FORMAT ( 48 + ( RANKX ( t, dim_tempo[ano_mes], , ASC ) - 1 ) * 690 / MAX ( n - 1, 1 ), "0.0", "en-US" ) & "' cy='" & FORMAT ( 300 - [@v] / topo * 280, "0.0", "en-US" ) & "' r='" & IF ( [@v] = mx, "6", "4" ) & "' fill='" & IF ( [@v] = mx, "#22D3EE", "#0E1430" ) & "' stroke='#8B5CF6' stroke-width='2.5'/>", "", dim_tempo[ano_mes], ASC )
			VAR pico = TOPN ( 1, t, [@v], DESC, dim_tempo[ano_mes], ASC )
			VAR pico_mes = MAXX ( pico, dim_tempo[ano_mes] )
			VAR pico_x = MAXX ( pico, FORMAT ( 48 + ( RANKX ( t, dim_tempo[ano_mes], , ASC ) - 1 ) * 690 / MAX ( n - 1, 1 ), "0.0", "en-US" ) )
			VAR pico_txt = IF ( n > 0, FORMAT ( DATEVALUE ( pico_mes & "-01" ), "mmm/yy" ) & ": R$ " & FORMAT ( mx / 1000000, "#,0.00" ) & " Mi" )
			VAR rotulos = CONCATENATEX ( FILTER ( t, MOD ( RANKX ( t, dim_tempo[ano_mes], , ASC ) - 1, 2 ) = 0 ), "<text x='" & FORMAT ( 48 + ( RANKX ( t, dim_tempo[ano_mes], , ASC ) - 1 ) * 690 / MAX ( n - 1, 1 ), "0.0", "en-US" ) & "' y='318' text-anchor='middle' fill='#8E9AC8' font-size='10.5'>" & FORMAT ( DATEVALUE ( dim_tempo[ano_mes] & "-01" ), "mm/yy" ) & "</text>", "", dim_tempo[ano_mes], ASC )
			VAR grade = CONCATENATEX ( GENERATESERIES ( 0, 3, 1 ), "<line x1='48' x2='750' y1='" & FORMAT ( 300 - [Value] / 3 * 280, "0.0", "en-US" ) & "' y2='" & FORMAT ( 300 - [Value] / 3 * 280, "0.0", "en-US" ) & "' stroke='rgba(130,150,255,0.10)'/><text x='40' y='" & FORMAT ( 304 - [Value] / 3 * 280, "0.0", "en-US" ) & "' text-anchor='end' fill='#8E9AC8' font-size='11'>" & IF ( [Value] = 0, "0", FORMAT ( topo * [Value] / 3 / 1000000, "0.0" ) & " Mi" ) & "</text>", "", [Value], ASC )
			RETURN
			IF ( n = 0, "<div style='font-family:Segoe UI,sans-serif;color:#8E9AC8;font-size:18.2px;padding:25.2px'>sem dados</div>", "<div style='font-family:Segoe UI,sans-serif;box-sizing:border-box;background:linear-gradient(160deg,#17214A,#121A3A);border:1.4px solid rgba(130,150,255,0.14);border-radius:25.2px;padding:19.6px 22.4px;height:100vh;overflow:hidden'><div style='font-size:19.6px;font-weight:600;color:#E8ECFF'>Receita por mês e no mesmo mês do ano anterior</div><div style='display:flex;gap:19.6px;font-size:15.4px;color:#8E9AC8;margin-top:8.4px'><span><i style='display:inline-block;width:25.2px;height:4.2px;border-radius:2.8px;margin-right:8.4px;vertical-align:middle;background:linear-gradient(90deg,#22D3EE,#8B5CF6)'></i>Receita</span><span><i style='display:inline-block;width:25.2px;height:4.2px;border-radius:2.8px;margin-right:8.4px;vertical-align:middle;background:#EC4899'></i>Ano anterior</span></div><svg width='100%' height='88%' viewBox='0 0 760 330' preserveAspectRatio='none'><defs><linearGradient id='ga' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#22D3EE' stop-opacity='0.45'/><stop offset='1' stop-color='#8B5CF6' stop-opacity='0'/></linearGradient><linearGradient id='gl' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#22D3EE'/><stop offset='1' stop-color='#8B5CF6'/></linearGradient></defs>" & grade & rotulos & "<path d='M48,300 L " & pts & " L738,300 Z' fill='url(#ga)'/><path d='M" & pts & "' fill='none' stroke='url(#gl)' stroke-width='3'/>" & IF ( COUNTROWS ( ta ) > 1, "<path d='M" & ptsa & "' fill='none' stroke='#EC4899' stroke-width='2' stroke-dasharray='6 5'/>" ) & pontos & "<text x='" & pico_x & "' y='" & FORMAT ( 300 - mx / topo * 280 - 14, "0.0", "en-US" ) & "' text-anchor='middle' fill='#E8ECFF' font-size='12' font-weight='700'>" & pico_txt & "</text></svg></div>" )
		displayFolder: HTML
		lineageTag: 642eab7b-be5f-4146-afbb-8b0fed201ec1

	/// Taxa de atraso por regiao em barras, com a linha da taxa nacional.
	measure 'HTML Atraso por Região' =
			VAR nac = [Taxa Nacional de Atraso]
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( dim_clientes[regiao] ), "@v", [Taxa de Atraso] ), NOT ISBLANK ( [@v] ) )
			VAR esc = MAX ( MAXX ( t, [@v] ), nac ) * 1.1
			VAR linhas = CONCATENATEX ( t, "<div style='display:flex;align-items:center;gap:14px;font-size:16.8px;margin-top:12.6px;color:#E8ECFF'><span style='width:134.4px'>" & dim_clientes[regiao] & "</span><div style='flex:1;height:11.2px;border-radius:8.4px;background:rgba(130,150,255,0.12);position:relative'><div style='width:" & FORMAT ( [@v] / esc * 100, "0.0", "en-US" ) & "%;height:11.2px;border-radius:8.4px;background:" & IF ( [@v] > nac, "linear-gradient(90deg,#F87171,#EC4899)", "linear-gradient(90deg,#22D3EE,#34D399)" ) & "'></div><div style='position:absolute;left:" & FORMAT ( nac / esc * 100, "0.0", "en-US" ) & "%;top:-4.2px;width:2.8px;height:19.6px;background:#FBBF24'></div></div><span style='width:72.8px;text-align:right'>" & FORMAT ( [@v], "0.0%" ) & "</span></div>", "", [@v], DESC )
			RETURN
			IF ( ISEMPTY ( t ), "<div style='font-family:Segoe UI,sans-serif;color:#8E9AC8;font-size:18.2px;padding:25.2px'>sem dados</div>", "<div style='font-family:Segoe UI,sans-serif;box-sizing:border-box;background:linear-gradient(160deg,#17214A,#121A3A);border:1.4px solid rgba(130,150,255,0.14);border-radius:25.2px;padding:19.6px 22.4px;height:100vh;overflow:hidden'><div style='font-size:19.6px;font-weight:600;color:#E8ECFF'>Taxa de atraso por região</div><div style='font-size:16.1px;color:#8E9AC8;margin-top:2.8px'>" & "Linha: média nacional (" & FORMAT ( nac, "0.0%" ) & ")</div>" & linhas & "</div>" )
		displayFolder: HTML
		lineageTag: 71fe8d36-7925-4bf9-95ca-659961d6f39b

	/// Atraso em excesso por UF em barras divergentes (vermelho acima da taxa nacional).
	measure 'HTML Excesso por UF' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( dim_clientes[uf] ), "@v", [Atraso em Excesso] ), NOT ISBLANK ( [@v] ) )
			VAR esc = MAX ( MAXX ( t, ABS ( [@v] ) ), 1 )
			VAR linhas = CONCATENATEX ( t, "<div style='display:flex;align-items:center;gap:11.2px;font-size:16.1px;margin-top:5.6px;color:#E8ECFF'><span style='width:33.6px'>" & dim_clientes[uf] & "</span><div style='flex:1;height:14px;position:relative'><div style='position:absolute;left:50%;top:-2.8px;width:1.4px;height:19.6px;background:rgba(130,150,255,0.35)'></div><div style='position:absolute;top:0;height:14px;border-radius:5.6px;left:" & FORMAT ( IF ( [@v] >= 0, 50, 50 - ABS ( [@v] ) / esc * 50 ), "0.0", "en-US" ) & "%;width:" & FORMAT ( ABS ( [@v] ) / esc * 50, "0.0", "en-US" ) & "%;background:" & IF ( [@v] > 0, "linear-gradient(90deg,#EC4899,#F87171)", "linear-gradient(90deg,#34D399,#22D3EE)" ) & "'></div></div><span style='width:64.4px;text-align:right'>" & FORMAT ( [@v], "+#,0;-#,0;0" ) & "</span></div>", "", [@v], DESC )
			RETURN
			IF ( ISEMPTY ( t ), "<div style='font-family:Segoe UI,sans-serif;color:#8E9AC8;font-size:18.2px;padding:25.2px'>sem dados</div>", "<div style='font-family:Segoe UI,sans-serif;box-sizing:border-box;background:linear-gradient(160deg,#17214A,#121A3A);border:1.4px solid rgba(130,150,255,0.14);border-radius:25.2px;padding:19.6px 22.4px;height:100vh;overflow:hidden'><div style='font-size:19.6px;font-weight:600;color:#E8ECFF'>Atraso em excesso por UF</div><div style='font-size:16.1px;color:#8E9AC8;margin-top:2.8px'>Vermelho: acima do esperado pela taxa nacional</div>" & linhas & "</div>" )
		displayFolder: HTML
		lineageTag: f246dddf-ffca-4e26-b3d4-f96f368bd56c

	/// Os 5 grupos de categoria com maior receita de itens.
	measure 'HTML Grupos Top 5' =
			VAR t = TOPN ( 5, FILTER ( ADDCOLUMNS ( VALUES ( dim_produtos[categoria_grupo] ), "@v", [Receita de Itens] ), NOT ISBLANK ( [@v] ) ), [@v], DESC, dim_produtos[categoria_grupo], ASC )
			VAR mx = MAXX ( t, [@v] )
			VAR linhas = CONCATENATEX ( t, "<div data-grupo='1' style='display:flex;align-items:center;gap:14px;font-size:16.8px;margin-top:12.6px;color:#E8ECFF'><span style='width:210px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dim_produtos[categoria_grupo], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</span><div style='flex:1;height:11.2px;border-radius:8.4px;background:rgba(130,150,255,0.12);position:relative'><div style='width:" & FORMAT ( [@v] / mx * 100, "0.0", "en-US" ) & "%;height:11.2px;border-radius:8.4px;background:linear-gradient(90deg,#8B5CF6,#22D3EE)'></div></div><span style='width:86.8px;text-align:right'>" & FORMAT ( [@v] / 1000000, "0.00" ) & " Mi</span></div>", "", [@v], DESC, dim_produtos[categoria_grupo], ASC )
			RETURN
			IF ( ISEMPTY ( t ), "<div style='font-family:Segoe UI,sans-serif;color:#8E9AC8;font-size:18.2px;padding:25.2px'>sem dados</div>", "<div style='font-family:Segoe UI,sans-serif;box-sizing:border-box;background:linear-gradient(160deg,#17214A,#121A3A);border:1.4px solid rgba(130,150,255,0.14);border-radius:25.2px;padding:19.6px 22.4px;height:100vh;overflow:hidden'><div style='font-size:19.6px;font-weight:600;color:#E8ECFF'>Receita de itens: 5 maiores grupos</div>" & linhas & "</div>" )
		displayFolder: HTML
		lineageTag: 47c0a46d-028a-4493-8fb7-5b232cf3ea1f

	/// Receita de itens de todos os grupos de categoria.
	measure 'HTML Grupos' =
			VAR t = FILTER ( ADDCOLUMNS ( VALUES ( dim_produtos[categoria_grupo] ), "@v", [Receita de Itens] ), NOT ISBLANK ( [@v] ) )
			VAR mx = MAXX ( t, [@v] )
			VAR linhas = CONCATENATEX ( t, "<div data-grupo='1' style='display:flex;align-items:center;gap:14px;font-size:16.8px;margin-top:12.6px;color:#E8ECFF'><span style='width:210px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dim_produtos[categoria_grupo], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</span><div style='flex:1;height:11.2px;border-radius:8.4px;background:rgba(130,150,255,0.12);position:relative'><div style='width:" & FORMAT ( [@v] / mx * 100, "0.0", "en-US" ) & "%;height:11.2px;border-radius:8.4px;background:linear-gradient(90deg,#8B5CF6,#22D3EE)'></div></div><span style='width:86.8px;text-align:right'>" & FORMAT ( [@v] / 1000000, "0.00" ) & " Mi</span></div>", "", [@v], DESC, dim_produtos[categoria_grupo], ASC )
			RETURN
			IF ( ISEMPTY ( t ), "<div style='font-family:Segoe UI,sans-serif;color:#8E9AC8;font-size:18.2px;padding:25.2px'>sem dados</div>", "<div style='font-family:Segoe UI,sans-serif;box-sizing:border-box;background:linear-gradient(160deg,#17214A,#121A3A);border:1.4px solid rgba(130,150,255,0.14);border-radius:25.2px;padding:19.6px 22.4px;height:100vh;overflow:hidden'><div style='font-size:19.6px;font-weight:600;color:#E8ECFF'>Receita de itens por grupo de categoria</div>" & linhas & "</div>" )
		displayFolder: HTML
		lineageTag: 2c4c9e33-42ca-4151-8b1c-4582983bfd90

	/// Os 50 pedidos em andamento de maior probabilidade de atraso (vermelho a partir de 40%, ambar de 30%).
	measure 'HTML Pedidos em Risco' =
			VAR t = TOPN ( 50, FILTER ( previsao_atraso, previsao_atraso[conjunto] = "em_andamento" ), previsao_atraso[prob_atraso], DESC, RELATED ( fato_pedidos[pedido_codigo] ), ASC )
			VAR linhas = CONCATENATEX ( t, "<tr style='" & IF ( previsao_atraso[prob_atraso] >= 0.4, "background:rgba(248,113,113,0.18)", IF ( previsao_atraso[prob_atraso] >= 0.3, "background:rgba(251,191,36,0.16)" ) ) & "'><td style='padding:9.8px 14px;border-top:1.4px solid rgba(130,150,255,0.10)'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( RELATED ( fato_pedidos[pedido_codigo] ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</td><td style='padding:9.8px 14px;border-top:1.4px solid rgba(130,150,255,0.10)'>" & FORMAT ( RELATED ( fato_pedidos[data_compra] ), "dd/mm/yyyy" ) & "</td><td style='padding:9.8px 14px;border-top:1.4px solid rgba(130,150,255,0.10)'>" & FORMAT ( RELATED ( fato_pedidos[entrega_prevista] ), "dd/mm/yyyy" ) & "</td><td style='padding:9.8px 14px;border-top:1.4px solid rgba(130,150,255,0.10)'>" & RELATED ( dim_clientes[uf] ) & "</td><td style='padding:9.8px 14px;border-top:1.4px solid rgba(130,150,255,0.10);text-align:right'>R$ " & FORMAT ( RELATED ( fato_pedidos[valor_total] ), "#,0.00" ) & "</td><td style='padding:9.8px 14px;border-top:1.4px solid rgba(130,150,255,0.10);text-align:right;font-weight:600'>" & FORMAT ( previsao_atraso[prob_atraso], "0.0%" ) & "</td></tr>", "", previsao_atraso[prob_atraso], DESC, RELATED ( fato_pedidos[pedido_codigo] ), ASC )
			RETURN
			IF ( ISEMPTY ( t ), "<div style='font-family:Segoe UI,sans-serif;color:#8E9AC8;font-size:18.2px;padding:25.2px'>sem dados</div>", "<div style='font-family:Segoe UI,sans-serif;box-sizing:border-box;background:linear-gradient(160deg,#17214A,#121A3A);border:1.4px solid rgba(130,150,255,0.14);border-radius:25.2px;padding:19.6px 22.4px;height:100vh;display:flex;flex-direction:column'><div style='font-size:19.6px;font-weight:600;color:#E8ECFF'>Pedidos em andamento por probabilidade de atraso</div><div style='font-size:16.1px;color:#8E9AC8;margin-top:2.8px'>Os 50 de maior risco comprados no período</div><div style='flex:1;overflow:auto;margin-top:11.2px'><table style='width:100%;border-collapse:collapse;font-size:16.8px;color:#E8ECFF'><tr><th style='padding:11.2px 14px;color:#8E9AC8;font-weight:600;text-align:left;position:sticky;top:0;background:#17214A'>Pedido</th><th style='padding:11.2px 14px;color:#8E9AC8;font-weight:600;text-align:left;position:sticky;top:0;background:#17214A'>Compra</th><th style='padding:11.2px 14px;color:#8E9AC8;font-weight:600;text-align:left;position:sticky;top:0;background:#17214A'>Entrega prevista</th><th style='padding:11.2px 14px;color:#8E9AC8;font-weight:600;text-align:left;position:sticky;top:0;background:#17214A'>UF</th><th style='padding:11.2px 14px;color:#8E9AC8;font-weight:600;text-align:left;position:sticky;top:0;background:#17214A;text-align:right'>Valor</th><th style='padding:11.2px 14px;color:#8E9AC8;font-weight:600;text-align:left;position:sticky;top:0;background:#17214A;text-align:right'>Prob.</th></tr>" & linhas & "</table></div></div>" )
		displayFolder: HTML
		lineageTag: 16482e79-8c07-4d0b-822f-791feea2ff8a

	/// Os 50 vendedores de maior receita de itens, com barra proporcional.
	measure 'HTML Vendedores' =
			VAR t = TOPN ( 50, FILTER ( ADDCOLUMNS ( VALUES ( dim_vendedores[vendedor_rotulo] ), "@r", [Receita de Itens], "@i", [Itens], "@t", [Taxa de Atraso dos Itens] ), NOT ISBLANK ( [@r] ) ), [@r], DESC, dim_vendedores[vendedor_rotulo], ASC )
			VAR mx = MAXX ( t, [@r] )
			VAR linhas = CONCATENATEX ( t, "<tr><td style='padding:9.8px 14px;border-top:1.4px solid rgba(130,150,255,0.10);white-space:nowrap'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dim_vendedores[vendedor_rotulo], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</td><td style='padding:9.8px 14px;border-top:1.4px solid rgba(130,150,255,0.10);width:34%'><div style='display:flex;align-items:center;gap:11.2px'><div style='flex:1;height:11.2px;border-radius:8.4px;background:rgba(130,150,255,0.12);position:relative'><div style='width:" & FORMAT ( [@r] / mx * 100, "0.0", "en-US" ) & "%;height:11.2px;border-radius:8.4px;background:linear-gradient(90deg,#8B5CF6,#22D3EE)'></div></div><span style='white-space:nowrap'>" & FORMAT ( [@r], "#,0.00" ) & "</span></div></td><td style='padding:9.8px 14px;border-top:1.4px solid rgba(130,150,255,0.10);text-align:right'>" & FORMAT ( [@i], "#,0" ) & "</td><td style='padding:9.8px 14px;border-top:1.4px solid rgba(130,150,255,0.10);text-align:right'>" & FORMAT ( [@t], "0.0%" ) & "</td></tr>", "", [@r], DESC, dim_vendedores[vendedor_rotulo], ASC )
			RETURN
			IF ( ISEMPTY ( t ), "<div style='font-family:Segoe UI,sans-serif;color:#8E9AC8;font-size:18.2px;padding:25.2px'>sem dados</div>", "<div style='font-family:Segoe UI,sans-serif;box-sizing:border-box;background:linear-gradient(160deg,#17214A,#121A3A);border:1.4px solid rgba(130,150,255,0.14);border-radius:25.2px;padding:19.6px 22.4px;height:100vh;display:flex;flex-direction:column'><div style='font-size:19.6px;font-weight:600;color:#E8ECFF'>Receita e atraso por vendedor</div><div style='font-size:16.1px;color:#8E9AC8;margin-top:2.8px'>Os 50 de maior receita de itens no período</div><div style='flex:1;overflow:auto;margin-top:11.2px'><table style='width:100%;border-collapse:collapse;font-size:16.8px;color:#E8ECFF'><tr><th style='padding:11.2px 14px;color:#8E9AC8;font-weight:600;text-align:left;position:sticky;top:0;background:#17214A'>Vendedor</th><th style='padding:11.2px 14px;color:#8E9AC8;font-weight:600;text-align:left;position:sticky;top:0;background:#17214A'>Receita de itens (R$)</th><th style='padding:11.2px 14px;color:#8E9AC8;font-weight:600;text-align:left;position:sticky;top:0;background:#17214A;text-align:right'>Itens</th><th style='padding:11.2px 14px;color:#8E9AC8;font-weight:600;text-align:left;position:sticky;top:0;background:#17214A;text-align:right'>Taxa de atraso</th></tr>" & linhas & "</table></div></div>" )
		displayFolder: HTML
		lineageTag: 790b2952-c680-4c33-9db3-ecb9ed8afa49

	/// Painel do dicionario: ate 3 metricas marcadas na segmentacao, sem selecao pede para escolher.
	measure 'HTML Dicionário' =
			VAR filtrado = ISFILTERED ( dicionario_metricas[Métrica] )
			VAR n = COUNTROWS ( dicionario_metricas )
			VAR t = TOPN ( 3, dicionario_metricas, dicionario_metricas[Ordem], ASC )
			VAR cartoes = CONCATENATEX ( t, "<div data-metrica='1' style='border:1.4px solid rgba(130,150,255,0.14);border-radius:19.6px;padding:15.4px 18.2px;margin-top:14px;background:rgba(255,255,255,0.03)'><div style='display:flex;align-items:baseline;gap:11.2px'><div style='font-size:19.6px;font-weight:700;color:#E8ECFF'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dicionario_metricas[Métrica], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</div><div style='flex:1'></div><div style='font-size:14px;color:#22D3EE'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dicionario_metricas[Página], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</div></div><div style='font-size:14px;letter-spacing:0.06em;text-transform:uppercase;color:#8E9AC8;margin-top:11.2px'>O que é</div><div style='font-size:16.8px;line-height:1.45;color:#E8ECFF;margin-top:2.8px'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dicionario_metricas[O que é], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</div><div style='font-size:14px;letter-spacing:0.06em;text-transform:uppercase;color:#8E9AC8;margin-top:11.2px'>Cálculo</div><div style='font-size:16.8px;line-height:1.45;color:#E8ECFF;margin-top:2.8px'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dicionario_metricas[Cálculo], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</div><div style='font-size:14px;letter-spacing:0.06em;text-transform:uppercase;color:#8E9AC8;margin-top:11.2px'>Exemplo</div><div style='font-size:16.8px;line-height:1.45;color:#E8ECFF;margin-top:2.8px'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( dicionario_metricas[Exemplo], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</div></div>", "", dicionario_metricas[Ordem], ASC )
			VAR mais = IF ( n > 3, "<div style='font-size:16.1px;color:#FBBF24;margin-top:14px'>e mais " & ( n - 3 ) & " marcadas: o painel mostra até 3 de cada vez.</div>" )
			VAR pedido = "<div style='font-size:17.5px;line-height:1.5;color:#8E9AC8;margin-top:16.8px'>Escolha uma métrica na busca acima para ver o que ela significa, como é calculada e um exemplo com os números do painel.</div>"
			RETURN
			"<div style='font-family:Segoe UI,sans-serif;box-sizing:border-box;background:linear-gradient(160deg,#17214A,#121A3A);border:1.4px solid rgba(130,150,255,0.14);border-radius:25.2px;padding:22.4px 22.4px;height:100vh;display:flex;flex-direction:column;box-shadow:0 33.6px 84px rgba(0,0,0,0.55)'><div style='display:flex;align-items:center;gap:11.2px'><div style='font-size:22.4px;font-weight:700;color:#E8ECFF'>Dicionário de <span style='background:linear-gradient(90deg,#22D3EE,#8B5CF6);-webkit-background-clip:text;background-clip:text;color:transparent'>métricas</span></div><div style='flex:1'></div><div style='width:36.4px;height:36.4px;border-radius:12.6px;display:flex;align-items:center;justify-content:center;background:rgba(130,150,255,0.12);color:#8E9AC8;font-size:22.4px'>×</div></div><div style='font-size:16.1px;color:#8E9AC8;margin-top:2.8px'>Busque e marque até 3 métricas</div><div style='height:86.8px;flex:none'></div><div style='flex:1;overflow:auto'>" & IF ( NOT filtrado || n = 0, pedido, cartoes & mais ) & "</div></div>"
		displayFolder: HTML
