# Copie este arquivo para .env e ajuste os valores.
# O .env NAO vai para o Git (esta no .gitignore). Nunca comite senha real.

# ---- PostgreSQL local (Docker Compose) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=olist
POSTGRES_USER=olist
POSTGRES_PASSWORD=olist

# Schema onde a ingestao Python grava as tabelas cruas
RAW_SCHEMA=raw

# ---- Fase 6: Agente IA (LangChain) ----
# Chave do provedor de LLM. Use so em ambiente local, nunca comite.
OPENAI_API_KEY=coloque_sua_chave_aqui
# Modelo barato por padrao para controlar custo de token
LLM_MODEL=gpt-4o-mini
