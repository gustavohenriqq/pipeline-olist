# ---- Dados brutos (nao versionar CSV pesado) ----
data/raw/*.csv
data/processed/
!data/raw/.gitkeep

# ---- Segredos ----
.env
*.env
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# ---- dbt ----
dbt/target/
dbt/dbt_packages/
dbt/logs/
logs/

# ---- Sistema / IDE ----
.DS_Store
.vscode/
.idea/

# ---- Docker ----
pgdata/

# ---- Pasta de descarte local (nao versionar) ----
_to_delete/

# ---- Arquivos gerados/internos que nao devem ser versionados ----
dbt/.user.yml
BRIEF.md
CLAUDE.md

# ---- Certificados e chaves (nunca versionar) ----
# isrgrootx1.pem e o certificado publico da Lets Encrypt usado pelo Looker
# Studio para conectar no Neon. Nao e segredo, mas nao pertence ao repo. A regra
# ampla protege tambem contra chave privada, que costuma ter a mesma extensao.
*.pem
*.key

# ---- Contexto pessoal (dados pessoais, pretensao, empresas-alvo) ----
contexto.md

# ---- Mockups gerados por IA com numeros inventados ----
# Nao publicar: a maioria dos valores nao bate com o banco (clientes, itens,
# variacoes "vs periodo anterior", cancelados 1,6% contra 0,59% real, ranking de
# categorias e estados) e o rodape atribui direitos a Olist, o que apresenta o
# projeto como produto oficial. O mockup conferido e olist_visao_geral.html.
dashboards/mockup/mockup-png.png
dashboards/mockup/olist_dashboard_premium_mockup.html

# Modelo treinado (binario, regeravel com python -m ml.treinar). As metricas sao versionadas.
ml/artefatos/*.joblib

# Power BI (PBIP): cache de dados importados e preferencias locais do Desktop
**/.pbi/localSettings.json
**/.pbi/cache.abf
