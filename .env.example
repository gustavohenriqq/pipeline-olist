# Copie este arquivo para .env e ajuste os valores.
# O .env NAO vai para o Git (esta no .gitignore). Nunca comite senha real.

# ---- PostgreSQL local (Docker Compose) ----
# Warehouse de desenvolvimento: e aqui que a ingestao grava e o dbt roda.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=olist
POSTGRES_USER=olist
POSTGRES_PASSWORD=olist

# Schema onde a ingestao Python grava as tabelas cruas
RAW_SCHEMA=raw

# ---- Neon: camada de servico do BI (Fase 1) ----
# Postgres serverless gratuito que hospeda SO as marts, para o Looker Studio
# ler 24/7 sem depender da sua maquina ligada.
#
# Por que so as marts: o free tier da 0,5 GB e a tabela raw "geolocation"
# sozinha tem 1 milhao de linhas. O star schema completo ocupa ~74 MB (14%).
# Em producao o BI tambem nunca le a camada crua, entao o desenho e o mesmo.
#
# Pegue a connection string em https://neon.tech (Dashboard -> Connect) no
# formato: postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
NEON_HOST=ep-xxxxx-pooler.regiao.aws.neon.tech
NEON_PORT=5432
NEON_DB=neondb
NEON_USER=neondb_owner
NEON_PASSWORD=coloque_sua_senha_aqui
NEON_SCHEMA=marts

# ---- Fase 6: Agente IA (LangChain) ----
# Chave do provedor de LLM. Use so em ambiente local, nunca comite.
OPENAI_API_KEY=coloque_sua_chave_aqui
# Modelo barato por padrao para controlar custo de token
LLM_MODEL=gpt-4o-mini
